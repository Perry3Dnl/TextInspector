<Project>
  <PropertyGroup>
    <Version>1.1.0</Version>
    <Authors>Perry3Dnl</Authors>
    <Copyright>Copyright © 2026 Perry3Dnl</Copyright>
    <PackageProjectUrl>https://github.com/Perry3Dnl/TextInspector</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Perry3Dnl/TextInspector.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PackageReleaseNotes>TextInspector 1.1.0 adds the multilingual lexical evidence update plus calibrated false-positive exclusions, negation handling, attributed-context handling, and expanded regression coverage. See CHANGELOG.md for release details.</PackageReleaseNotes>
  </PropertyGroup>
</Project>
