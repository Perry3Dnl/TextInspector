<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TextInspector.AspNetCore</RootNamespace>
    <AssemblyName>TextInspector.AspNetCore</AssemblyName>

    <IsPackable>true</IsPackable>
    <PackageId>TextInspector.Lite.AspNetCore</PackageId>
    <Title>TextInspector Lite ASP.NET Core integration</Title>
    <Description>TextInspector Lite: fixed built-in text detection with exact evidence, explainable risk scoring and UI-ready reports.</Description>
    <PackageTags>textinspector;aspnetcore;dependency-injection;moderation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TextInspector.csproj" />
    <None Include="../LICENSE" Pack="true" PackagePath="" Link="LICENSE" />
    <None Remove="README.md" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="../CHANGELOG.md" Pack="true" PackagePath="" Link="CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="3.1.32" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

</Project>
